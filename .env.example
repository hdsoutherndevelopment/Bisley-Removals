# Site tier, from the HD Southern build standard (see AGENTS.md).
#   Unset, or anything other than "official": the demo. Every page is noindex, robots.txt
#   disallows crawling, and there are no enquiry forms: visitors reach the business by phone,
#   email and its own Removals Manager quote form. The /api routes return 404.
#   "official": only on the launched site on the client's domain. The quote and contact forms
#   render, and every enquiry must be delivered: if neither the email nor the database write
#   works, the visitor gets an error telling them to call. A form never shows a false success.
SITE_TIER=

# Absolute address of this deployment. Used for canonical links, the sitemap, structured data
# and the share image. On the demo, the vercel.app address; at launch, https://bisleyremovals.co.uk
NEXT_PUBLIC_SITE_URL=

# Official tier only: where enquiries go. Configure both; at least one must work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=            # e.g. "Bisley Removal Services <enquiries@bisleyremovals.co.uk>", a domain verified in Resend
BUSINESS_EMAIL=               # the office inbox that receives quote requests and messages
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server only, never sent to the browser. Run supabase/schema.sql first.
